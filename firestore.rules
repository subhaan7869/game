rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "hassennabeel9@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ===============================================================
    // Entity Validations
    // ===============================================================

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('uid' in data) || (data.uid is string && data.uid == request.auth.uid)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('profilePic' in data) || (data.profilePic is string && data.profilePic.size() < 1000)) &&
             (!('isOnline' in data) || (data.isOnline is bool)) &&
             (!('tier' in data) || (data.tier in ['Blue', 'Gold', 'Platinum', 'Diamond'])) &&
             (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
             (!('points' in data) || (data.points is number && data.points >= 0)) &&
             (!('experience' in data) || (data.experience is number && data.experience >= 0)) &&
             (!('level' in data) || (data.level is number && data.level > 0)) &&
             (!('deliveries' in data) || (data.deliveries is number && data.deliveries >= 0)) &&
             (!('walletBalance' in data) || (data.walletBalance is number && data.walletBalance >= 0)) &&
             (!('documentExpiries' in data) || (data.documentExpiries is map && data.documentExpiries.keys().size() < 20));
    }

    function isValidStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'accepted' && (newStatus == 'picked_up' || newStatus == 'accepted')) ||
             (oldStatus == 'picked_up' && (newStatus == 'arrived' || newStatus == 'picked_up')) ||
             (oldStatus == 'arrived' && (newStatus == 'completed' || newStatus == 'arrived')) ||
             (oldStatus == 'completed' && newStatus == 'completed');
    }

    function isValidScheduledOrder(data) {
      return data.driverUid is string && data.driverUid == request.auth.uid &&
             data.restaurantName is string && data.restaurantName.size() > 0 && 
             data.restaurantName.size() < 200 &&
             (data.scheduledTime is string || data.scheduledTime is timestamp) &&
             data.status in ['pending', 'active', 'completed'];
    }

    function isValidActiveOrder(data) {
      return data.driverUid is string && data.driverUid == request.auth.uid &&
             data.restaurantName is string && data.restaurantName.size() > 0 &&
             data.status in ['accepted', 'picked_up', 'arrived', 'completed'];
    }

    function isValidCarPlaySync(data) {
      return data.driverUid == request.auth.uid &&
             data.isActive is bool &&
             (!('activeOrderId' in data) || data.activeOrderId == null || data.activeOrderId is string) &&
             data.isNavigating is bool &&
             (data.lastUpdated == request.time);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().walletBalance == 0 &&
                    incoming().points == 0 &&
                    incoming().rating == 5.0 &&
                    (!('faceVerified' in incoming()) || incoming().faceVerified == false);
      
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                    // Restrict direct manipulation of critical fields as per security audit.
                    // These should ideally be managed by a trusted backend environment.
                    (!affectedKeys().hasAny(['walletBalance', 'points', 'rating', 'deliveries', 'tier', 'level', 'experience', 'faceVerified']) || isAdmin());
      
      allow delete: if isAdmin();
    }

    match /scheduled_orders/{orderId} {
      allow get: if isAuthenticated() && (existing().driverUid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.driverUid == request.auth.uid || isAdmin());
      
      allow create: if isAuthenticated() && isValidScheduledOrder(incoming());
      
      allow update: if isAuthenticated() && (existing().driverUid == request.auth.uid || isAdmin()) && 
                    isValidScheduledOrder(incoming()) &&
                    !affectedKeys().hasAny(['driverUid']);
      
      allow delete: if isAuthenticated() && (existing().driverUid == request.auth.uid || isAdmin());
    }

    match /carplay_sync/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) && isValidCarPlaySync(incoming()) &&
                    incoming().driverUid == userId;
      
      allow update: if isOwner(userId) && isValidCarPlaySync(incoming()) &&
                    !affectedKeys().hasAny(['driverUid']);
      
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /active_orders/{orderId} {
      allow get: if isAuthenticated() && (existing().driverUid == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.driverUid == request.auth.uid || isAdmin());
      
      allow create: if isAuthenticated() && isValidActiveOrder(incoming()) &&
                    incoming().status == 'accepted';
                    
      allow update: if isAuthenticated() && (existing().driverUid == request.auth.uid || isAdmin()) && 
                    isValidActiveOrder(incoming()) &&
                    isValidStatusTransition(existing().status, incoming().status) &&
                    !affectedKeys().hasAny(['driverUid', 'restaurantName', 'estimatedPay']);
                    
      allow delete: if isAuthenticated() && (existing().driverUid == request.auth.uid || isAdmin());
    }
  }
}
